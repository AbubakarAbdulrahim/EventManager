import React, { createContext, useState, useEffect, useContext, useCallback, useRef } from 'react';
import axios from 'axios';
import { useNavigate } from 'react-router-dom'; // Assuming you're using react-router-dom

// Create an Axios instance specifically for our authAxios requests
// This allows us to attach interceptors to it without affecting other potential axios instances
const authAxios = axios.create({
    baseURL: import.meta.env.VITE_API_URL,
    withCredentials: true, // This is crucial for sending HttpOnly cookies
});

const AuthContext = createContext(null);

export const AuthProvider = ({ children }) => {
    const [user, setUser] = useState(null); // Stores decoded user info (e.g., id, name, email)
    const [loading, setLoading] = useState(true); // Manages initial loading state
    const [accessToken, setAccessToken] = useState(null); // Access token stored in memory
    const navigate = useNavigate();

    // Use a ref to keep track of the current accessToken outside of interceptor's closure
    // This prevents stale `accessToken` values within the interceptor
    const accessTokenRef = useRef(accessToken);
    useEffect(() => {
        accessTokenRef.current = accessToken;
    }, [accessToken]);

    // --- Helper function to decode JWT (simplified, use a library like jwt-decode in production) ---
    const decodeJwt = (token) => {
        try {
            const base64Url = token.split('.')[1];
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const jsonPayload = decodeURIComponent(
                atob(base64)
                    .split('')
                    .map(function(c) {
                        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                    })
                    .join('')
            );
            return JSON.parse(jsonPayload);
        } catch (e) {
            console.error("Failed to decode JWT:", e);
            return null;
        }
    };

    // --- Function to fetch user data after successful token acquisition ---
    const fetchUserData = useCallback(async (token) => {
        if (!token) {
            setUser(null);
            return;
        }
        try {
            // Temporarily set the header for this specific request if accessToken state isn't updated yet
            const response = await authAxios.get('/auth/me', {
                headers: {
                    Authorization: `Bearer ${token}`
                }
            });
            setUser(response.data.user); // Assuming your /auth/me endpoint returns { user: {id, name, email} }
        } catch (error) {
            console.error('Failed to fetch user data:', error);
            setUser(null); // Clear user if fetching fails (e.g., token invalid/expired)
            setAccessToken(null); // Also clear access token if user data can't be fetched
        }
    }, []);

    // --- Function to refresh the access token ---
    const refreshAccessToken = useCallback(async () => {
        console.log('Attempting to refresh access token...');
        try {
            // The backend /auth/refresh endpoint will read the HttpOnly refresh token from the cookie
            const response = await authAxios.post('/user/token/refresh/');
            const newAccessToken = response.data.access;
            setAccessToken(newAccessToken);
            console.log('Access token refreshed successfully.');

            // After getting a new token, fetch user data with the new token
            await fetchUserData(newAccessToken);
            return newAccessToken;
        } catch (error) {
            console.error('Failed to refresh access token:', error.response?.data?.message || error.message);
            // If refresh fails, it means the refresh token is invalid/expired. Log out the user.
            logout(); // This will clear all tokens and redirect
            return null;
        } finally {
            setLoading(false); // Ensure loading is false after attempt
        }
    }, [fetchUserData, navigate]); // Added navigate to dependency array for logout redirect

    // --- Initial Load Effect: Check for refresh token and try to get a new access token ---
    useEffect(() => {
        // This runs only once on mount to silently request a new access token if the user refreshed the page
        // or just opened the app with an existing refresh token cookie.
        const initializeAuth = async () => {
            await refreshAccessToken(); // Attempt to get a new access token from refresh token
            setLoading(false);
        };
        initializeAuth();
    }, [refreshAccessToken]); // Dependency on refreshAccessToken to ensure it's up-to-date


    // --- Axios Interceptors ---
    // Request Interceptor: Attach the current access token to outgoing requests
    useEffect(() => {
        const requestInterceptor = authAxios.interceptors.request.use(
            (config) => {
                // Use accessTokenRef.current to get the most up-to-date token
                const token = accessTokenRef.current;
                if (token && !config.headers.Authorization) { // Only set if not already present
                    config.headers.Authorization = `Bearer ${token}`;
                }
                return config;
            },
            (error) => {
                return Promise.reject(error);
            }
        );

        // Response Interceptor: Handle 401 (Unauthorized) errors
        const responseInterceptor = authAxios.interceptors.response.use(
            (response) => response,
            async (error) => {
                const originalRequest = error.config;
                // Check if it's a 401 error and not a retry attempt already
                // And ensure it's not the /auth/login or /auth/refresh endpoint itself
                if (
                    error.response?.status === 401 &&
                    !originalRequest._retry &&
                    !originalRequest.url.includes('/user/token') &&
                    !originalRequest.url.includes('/user/token/refresh')
                ) {
                    originalRequest._retry = true; // Mark as retried
                    console.warn('401 Unauthorized. Attempting to refresh token...');

                    const newAccessToken = await refreshAccessToken(); // Get a new token

                    if (newAccessToken) {
                        // Update the Authorization header for the original failed request
                        originalRequest.headers.Authorization = `Bearer ${newAccessToken}`;
                        // Re-send the original request with the new token
                        return authAxios(originalRequest);
                    }
                }
                // For any other errors, or if refresh failed, just reject the promise
                return Promise.reject(error);
            }
        );

        // Cleanup interceptors on unmount
        return () => {
            authAxios.interceptors.request.eject(requestInterceptor);
            authAxios.interceptors.response.eject(responseInterceptor);
        };
    }, [refreshAccessToken]); // Depend on refreshAccessToken to get the latest version


    // --- Authentication Functions ---

    const login = useCallback(async (credentials) => {
        setLoading(true); // Indicate loading for login
        try {
            const response = await authAxios.post('/user/token/', credentials);
            const newAccessToken = response.data.access;

            if (newAccessToken) {
                setAccessToken(newAccessToken);
                // After getting the access token, decode it and fetch user data
                await fetchUserData(newAccessToken);
                console.log('Login successful.');
                return true;
            }
            return false;
        } catch (error) {
            console.error('Login failed:', error.response?.data?.message || error.message);
            // DO NOT go into a loop. Just set user to null and return false.
            setUser(null);
            setAccessToken(null);
            return false;
        } finally {
            setLoading(false); // End loading regardless of success/failure
        }
    }, [fetchUserData]); // Dependency on fetchUserData

    const logout = useCallback(async () => {
        try {
            // Call the backend to invalidate the refresh token on the server
            await authAxios.post('/user/logout/');
            console.log('Logged out successfully on server.');
        } catch (error) {
            console.error('Failed to logout on server:', error);
            // Even if server logout fails, clear client-side state
        } finally {
            setUser(null);
            setAccessToken(null); // Clear access token from memory
            // No need to clear local storage as we are not using it for tokens
            navigate('/login'); // Redirect to login page
        }
    }, [navigate]);

    // --- Memoize the context value to prevent unnecessary re-renders ---
    const authContextValue = React.useMemo(() => ({
        user,
        loading,
        login,
        logout,
        isAuthenticated: !!user, // Simple check if a user object exists
        authAxios // Expose the configured axios instance for authenticated requests
    }), [user, loading, login, logout]);

    if (loading) {
        // You can return a loading spinner or skeleton screen here
        return <div>Loading authentication...</div>;
    }

    return (
        <AuthContext.Provider value={authContextValue}>
            {children}
        </AuthContext.Provider>
    );
};

export const useAuth = () => {
    const context = useContext(AuthContext);
    if (context === undefined) {
        throw new Error('useAuth must be used within an AuthProvider');
    }
    return context;
};  



import React, { createContext, useContext, useState, useEffect, useCallback, useRef } from 'react';
import axios from 'axios';
import { jwtDecode } from 'jwt-decode'; // Correct import for jwt-decode

// --- Configuration ---
const API_BASE_URL = import.meta.env.VITE_API_URL;
const LOGIN_URL = '/user/token/';
const REFRESH_TOKEN_URL = '/user/token/refresh/';
const LOGOUT_URL = '/user/logout/';
const USER_DATA_URL_PREFIX = '/user/';

// --- Create Auth Context ---
const AuthContext = createContext(null);

// --- Axios Instance for API Calls (without interceptors initially) ---
const authAxios = axios.create({
  baseURL: API_BASE_URL,
  withCredentials: true, // Important for sending HttpOnly cookies
});

// A flag to prevent multiple token refresh requests
let isRefreshing = false;
let failedQueue = [];

const processQueue = (error, token = null) => {
  failedQueue.forEach(prom => {
    if (error) {
      prom.reject(error);
    } else {
      prom.resolve(token);
    }
  });
  failedQueue = [];
};

// --- Auth Provider Component ---
export const AuthProvider = ({ children }) => {
  const [accessToken, setAccessToken] = useState(null);
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const initialLoadRef = useRef(true); // Ref to track initial load

  // --- Silent Token Refresh Function ---
  const silentRefreshToken = useCallback(async () => {
    if (isRefreshing) {
      return new Promise((resolve, reject) => {
        failedQueue.push({ resolve, reject });
      });
    }

    isRefreshing = true;

    try {
      const response = await authAxios.post(REFRESH_TOKEN_URL);
      const newAccessToken = response.data.access; // Assuming your refresh endpoint returns { access: 'new_token' }

      if (newAccessToken) {
        setAccessToken(newAccessToken);
        setIsAuthenticated(true);
        const decodedToken = jwtDecode(newAccessToken);
        const userId = decodedToken.user_id || decodedToken.sub; // Adjust key based on your token

        if (userId) {
          try {
            const userResponse = await authAxios.get(`${USER_DATA_URL_PREFIX}${userId}/`, {
              headers: {
                Authorization: `Bearer ${newAccessToken}`,
              },
            });
            setUser(userResponse.data);
          } catch (error) {
            console.error('Failed to fetch user data after refresh:', error);
            setUser(null);
          }
        }
        processQueue(null, newAccessToken);
        return newAccessToken;
      } else {
        console.error('Refresh token failed: No new access token received.');
        setIsAuthenticated(false);
        setAccessToken(null);
        setUser(null);
        processQueue(new Error('Refresh token failed: No new access token.'), null);
        return null;
      }
    } catch (error) {
      console.error('Error refreshing token:', error);
      setIsAuthenticated(false);
      setAccessToken(null);
      setUser(null);
      processQueue(error, null);
      return null;
    } finally {
      isRefreshing = false;
    }
  }, []);

  // --- Axios Request Interceptor ---
  useEffect(() => {
    const requestInterceptor = authAxios.interceptors.request.use(
      async (config) => {
        if (accessToken && !config.url.includes(LOGIN_URL) && !config.url.includes(REFRESH_TOKEN_URL)) {
          config.headers.Authorization = `Bearer ${accessToken}`;
        }
        return config;
      },
      (error) => {
        return Promise.reject(error);
      }
    );

    // --- Axios Response Interceptor (for Token Refresh) ---
    const responseInterceptor = authAxios.interceptors.response.use(
      (response) => response,
      async (error) => {
        const originalRequest = error.config;

        if (
          error.response?.status === 401 &&
          originalRequest.url !== LOGIN_URL &&
          originalRequest.url !== REFRESH_TOKEN_URL &&
          !originalRequest._retry
        ) {
          originalRequest._retry = true;

          try {
            const newAccessToken = await silentRefreshToken();
            if (newAccessToken) {
              originalRequest.headers.Authorization = `Bearer ${newAccessToken}`;
              return authAxios(originalRequest);
            } else {
              logout();
              return Promise.reject(error);
            }
          } catch (refreshError) {
            console.error('Failed to refresh token during interceptor retry:', refreshError);
            logout();
            return Promise.reject(error);
          }
        }
        return Promise.reject(error);
      }
    );

    return () => {
      authAxios.interceptors.request.eject(requestInterceptor);
      authAxios.interceptors.response.eject(responseInterceptor);
    };
  }, [accessToken, silentRefreshToken]);

  // --- Initial Load Effect (Silent Refresh on Mount) ---
  useEffect(() => {
    const checkAuthStatus = async () => {
      if (initialLoadRef.current) {
        initialLoadRef.current = false;
        setLoading(true);
        await silentRefreshToken();
        setLoading(false);
      }
    };
    checkAuthStatus();
  }, [silentRefreshToken]);

  // --- Login Function ---
  const login = useCallback(async (credentials) => {
    setLoading(true);
    try {
      const res = await authAxios.post(LOGIN_URL, credentials);
      const newAccessToken = res.data.access; // Assuming your login response has { access: 'token', refresh: '...' }

      if (newAccessToken) {
        setAccessToken(newAccessToken);
        setIsAuthenticated(true);
        const decodedToken = jwtDecode(newAccessToken);
        const userId = decodedToken.user_id || decodedToken.sub; // Adjust key based on your token

        if (userId) {
          try {
            const userRes = await authAxios.get(`${USER_DATA_URL_PREFIX}${userId}/`, {
              headers: {
                Authorization: `Bearer ${newAccessToken}`,
              },
            });
            setUser(userRes.data);
          } catch (error) {
            console.error('Failed to fetch user data after login:', error);
            setUser(null);
          }
        }
        return true;
      }
      return false;
    } catch (error) {
      console.error('Login failed:', error);
      setIsAuthenticated(false);
      setAccessToken(null);
      setUser(null);
      if (error.response?.status === 401) {
        alert('Invalid credentials. Please try again.');
      }
      return false;
    } finally {
      setLoading(false);
    }
  }, []);

  // --- Logout Function ---
  const logout = useCallback(async () => {
    setLoading(true);
    try {
      await authAxios.post(LOGOUT_URL);
    } catch (error) {
      console.error('Logout failed:', error);
    } finally {
      setAccessToken(null);
      setUser(null);
      setIsAuthenticated(false);
      setLoading(false);
    }
  }, []);

  // --- Memoized Auth Value ---
  const authValue = React.useMemo(() => ({
    accessToken,
    user,
    isAuthenticated,
    loading,
    login,
    logout,
    silentRefreshToken,
    authAxios, // Expose the configured axios instance
  }), [accessToken, user, isAuthenticated, loading, login, logout, silentRefreshToken]);

  if (loading && initialLoadRef.current) {
    return <div>Loading authentication...</div>;
  }

  return (
    <AuthContext.Provider value={authValue}>
      {children}
    </AuthContext.Provider>
  );
};

// --- Custom Hook to use Auth Context ---
export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};