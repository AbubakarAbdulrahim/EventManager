import { useState } from 'react';
import { Dialog, DialogTitle, DialogContent, DialogActions, Button, Grid, MenuItem } from '@mui/material';
import { Formik, Form, Field, useFormikContext } from 'formik';
import { TextField, Select } from 'formik-mui';
import * as Yup from 'yup';
import { DatePicker } from '@mui/x-date-pickers';
import { TimePicker } from '@mui/x-date-pickers/TimePicker';

const serviceTypes = [
  { value: 'venue', label: 'Venue' },
  { value: 'caterer', label: 'Caterer' },
  { value: 'photographer', label: 'Photographer' },
  { value: 'musician', label: 'Musician' },
];

const validationSchema = Yup.object().shape({
  serviceType: Yup.string().required('Required'),
  name: Yup.string().required('Required'),
  description: Yup.string().required('Required'),
  mainImage: Yup.mixed().required('Main image is required'),
  additionalImages: Yup.array().max(5, 'Maximum 5 additional images allowed'),
  availability: Yup.array().of(
    Yup.object().shape({
      date: Yup.date().required(),
      timeSlots: Yup.array().of(
        Yup.object().shape({
          start: Yup.date().required(),
          end: Yup.date().required(),
        })
      ),
    })
  ),
  // Add more validations for specific service types
});

const ServiceSpecificFields = () => {
  const { values } = useFormikContext();

  switch (values.serviceType) {
    case 'venue':
      return (
        <Grid container spacing={2}>
          <Grid item xs={6}>
            <Field
              component={TextField}
              name="capacity"
              label="Capacity"
              type="number"
              fullWidth
            />
          </Grid>
          <Grid item xs={6}>
            <Field
              component={Select}
              name="venueType"
              label="Venue Type"
              fullWidth
            >
              <MenuItem value="indoor">Indoor</MenuItem>
              <MenuItem value="outdoor">Outdoor</MenuItem>
            </Field>
          </Grid>
        </Grid>
      );
    case 'caterer':
      return (
        <Grid container spacing={2}>
          <Grid item xs={6}>
            <Field
              component={TextField}
              name="cuisineType"
              label="Cuisine Type"
              fullWidth
            />
          </Grid>
          <Grid item xs={6}>
            <Field
              component={TextField}
              name="maxPlates"
              label="Maximum Plates"
              type="number"
              fullWidth
            />
          </Grid>
        </Grid>
      );
    // Add other service types
    default:
      return null;
  }
};

const AvailabilityPicker = () => {
  const [selectedDate, setSelectedDate] = useState(null);
  const { setFieldValue, values } = useFormikContext();

  const handleAddDate = (date) => {
    const newAvailability = [...values.availability, { date, timeSlots: [] }];
    setFieldValue('availability', newAvailability);
  };

  const handleAddTimeSlot = (dateIndex, start, end) => {
    const updated = [...values.availability];
    updated[dateIndex].timeSlots.push({ start, end });
    setFieldValue('availability', updated);
  };

  return (
    <div>
      <DatePicker
        label="Add Available Date"
        value={selectedDate}
        onChange={(newValue) => setSelectedDate(newValue)}
      />
      <Button onClick={() => selectedDate && handleAddDate(selectedDate)}>
        Add Date
      </Button>

      {values.availability.map((dateSlot, index) => (
        <div key={index}>
          <h4>{new Date(dateSlot.date).toLocaleDateString()}</h4>
          <TimePicker label="Start Time" /* Add handler */ />
          <TimePicker label="End Time" /* Add handler */ />
          <Button onClick={() => handleAddTimeSlot(index, start, end)}>
            Add Time Slot
          </Button>
        </div>
      ))}
    </div>
  );
};

const PricingFields = () => {
  const { values } = useFormikContext();

  return (
    <div>
      <Field component={Select} name="pricingModel" label="Pricing Model">
        {values.serviceType === 'venue' && (
          <>
            <MenuItem value="hourly">Per Hour</MenuItem>
            <MenuItem value="daily">Per Day</MenuItem>
          </>
        )}
        {values.serviceType === 'caterer' && (
          <>
            <MenuItem value="perPlate">Per Plate</MenuItem>
            <MenuItem value="package">Package</MenuItem>
          </>
        )}
      </Field>

      {values.pricingModel === 'perPlate' && (
        <Field component={TextField} name="pricePerPlate" label="Price per Plate" />
      )}
      {values.pricingModel === 'package' && (
        <div>
          <Field component={TextField} name="packageQuantity" label="Quantity" />
          <Field component={TextField} name="packagePrice" label="Total Price" />
        </div>
      )}
    </div>
  );
};

const AddServiceDialog = ({ open, onClose }) => {
  const initialValues = {
    serviceType: '',
    name: '',
    description: '',
    mainImage: null,
    additionalImages: [],
    availability: [],
    pricingModel: '',
  };

  const handleSubmit = (values) => {
    // Handle form submission
    console.log(values);
    onClose();
  };

  return (
    <Dialog open={open} onClose={onClose} maxWidth="md" fullWidth>
      <DialogTitle>Add New Service</DialogTitle>
      <Formik
        initialValues={initialValues}
        validationSchema={validationSchema}
        onSubmit={handleSubmit}
      >
        {({ isSubmitting, setFieldValue }) => (
          <Form>
            <DialogContent>
              <Grid container spacing={3}>
                <Grid item xs={12}>
                  <Field
                    component={Select}
                    name="serviceType"
                    label="Service Type"
                    fullWidth
                  >
                    {serviceTypes.map((type) => (
                      <MenuItem key={type.value} value={type.value}>
                        {type.label}
                      </MenuItem>
                    ))}
                  </Field>
                </Grid>

                <Grid item xs={12}>
                  <Field
                    component={TextField}
                    name="name"
                    label="Service Name"
                    fullWidth
                  />
                </Grid>

                <Grid item xs={12}>
                  <Field
                    component={TextField}
                    name="description"
                    label="Description"
                    multiline
                    rows={4}
                    fullWidth
                  />
                </Grid>

                <Grid item xs={12}>
                  <ServiceSpecificFields />
                </Grid>

                <Grid item xs={12}>
                  <PricingFields />
                </Grid>

                <Grid item xs={12}>
                  <AvailabilityPicker />
                </Grid>

                <Grid item xs={12}>
                  <input
                    accept="image/*"
                    type="file"
                    onChange={(e) => {
                      setFieldValue('mainImage', e.target.files?.[0]);
                    }}
                  />
                </Grid>

                <Grid item xs={12}>
                  <input
                    accept="image/*"
                    type="file"
                    multiple
                    onChange={(e) => {
                      setFieldValue('additionalImages', [...e.target.files]);
                    }}
                  />
                </Grid>
              </Grid>
            </DialogContent>

            <DialogActions>
              <Button onClick={onClose}>Cancel</Button>
              <Button type="submit" disabled={isSubmitting}>
                Submit
              </Button>
            </DialogActions>
          </Form>
        )}
      </Formik>
    </Dialog>
  );
};

export default AddServiceDialog;